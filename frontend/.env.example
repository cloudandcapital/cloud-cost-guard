REACT_APP_BACKEND_URL=/api

# Server-side only — set this in Vercel environment variables, NOT in frontend .env
# This key must NOT have the REACT_APP_ prefix or it will be inlined into the browser bundle
ANTHROPIC_API_KEY=your_key_here

# Safe frontend toggle — controls whether the Lumen chat widget is shown
# This is NOT a secret; it just tells the UI that the backend is configured
REACT_APP_LUMEN_ENABLED=true
